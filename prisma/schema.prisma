generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  PHARMACIST
  ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
}

enum PharmacistVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_REVISION
}

enum PharmacistAvailabilityStatus {
  ONLINE
  OFFLINE
}

enum ConsultationSessionStatus {
  ACTIVE
  WAITING_USER
  WAITING_PHARMACIST
  COMPLETED
  REFERRED
  CANCELED
}

enum ConsultationMessageType {
  TEXT
  IMAGE
  SYSTEM
  SUMMARY
}

enum ConsultationFinalStatus {
  COMPLETED
  REFERRED
}

enum DrugPublicationStatus {
  DRAFT
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ArticlePublicationStatus {
  DRAFT
  PUBLISHED
  REJECTED
}

enum EducationalVideoPublicationStatus {
  DRAFT
  PUBLISHED
  REJECTED
}

enum ForumThreadStatus {
  ACTIVE
  LOCKED
  HIDDEN
}

enum ForumPostStatus {
  VISIBLE
  HIDDEN
}

enum ForumReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ForumReportTargetType {
  THREAD
  POST
}

model User {
  id                 String                @id
  name               String
  email              String                @unique
  emailVerified      Boolean               @default(false)
  image              String?
  phone              String?               @unique
  role               UserRole              @default(PATIENT)
  status             AccountStatus         @default(ACTIVE)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  sessions           Session[]
  accounts           Account[]
  patientProfile     PatientProfile?
  pharmacistProfile  PharmacistProfile?
  patientSessions    ConsultationSession[] @relation("PatientConsultations")
  pharmacistSessions ConsultationSession[] @relation("PharmacistConsultations")
  sentMessages       ConsultationMessage[] @relation("MessageSender")
  createdSummaries   ConsultationSummary[] @relation("SummaryCreator")
  reviewedDrugs      DrugInformation[]     @relation("DrugReviewer")
  authoredArticles    Article[]             @relation("ArticleAuthor")
  authoredVideos      EducationalVideo[]    @relation("EducationalVideoAuthor")
  forumThreads        ForumThread[]         @relation("ForumThreadAuthor")
  lockedForumThreads  ForumThread[]         @relation("ForumThreadLocker")
  hiddenForumThreads  ForumThread[]         @relation("ForumThreadHider")
  forumPosts          ForumPost[]           @relation("ForumPostAuthor")
  hiddenForumPosts    ForumPost[]           @relation("ForumPostHider")
  forumPostAttachments ForumPostAttachment[] @relation("ForumPostAttachmentUploader")
  forumReports        ForumReport[]         @relation("ForumReportReporter")
  resolvedForumReports ForumReport[]        @relation("ForumReportResolver")
  forumSubscriptions  ForumSubscription[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model PatientProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate DateTime?
  age       Int?
  phone     String?
  gender    Gender?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PharmacistProfile {
  id                 String                       @id @default(cuid())
  userId             String                       @unique
  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  strNumber          String                       @unique
  profilePhotoUrl    String?
  bio                String
  topics             String[]
  practiceLocation   String
  serviceHours       String
  experienceSummary  String
  strDocumentUrl     String?
  verificationStatus PharmacistVerificationStatus @default(PENDING)
  availabilityStatus PharmacistAvailabilityStatus @default(OFFLINE)
  adminNote          String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
}

model ConsultationSession {
  id                    String                    @id @default(cuid())
  patientId             String
  patient               User                      @relation("PatientConsultations", fields: [patientId], references: [id], onDelete: Cascade)
  pharmacistId          String
  pharmacist            User                      @relation("PharmacistConsultations", fields: [pharmacistId], references: [id], onDelete: Cascade)
  status                ConsultationSessionStatus @default(ACTIVE)
  startedAt             DateTime                  @default(now())
  endedAt               DateTime?
  patientUnreadCount    Int                       @default(0)
  pharmacistUnreadCount Int                       @default(0)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  messages              ConsultationMessage[]
  summary               ConsultationSummary?

  @@index([patientId])
  @@index([pharmacistId])
  @@index([status])
}

model ConsultationMessage {
  id          String                   @id @default(cuid())
  sessionId   String
  session     ConsultationSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User                     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  type        ConsultationMessageType  @default(TEXT)
  body        String?
  createdAt   DateTime                 @default(now())
  attachments ConsultationAttachment[]

  @@index([sessionId])
  @@index([senderId])
}

model ConsultationAttachment {
  id        String              @id @default(cuid())
  messageId String
  message   ConsultationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileType  String
  fileName  String
  createdAt DateTime            @default(now())

  @@index([messageId])
}

model ConsultationSummary {
  id             String                  @id @default(cuid())
  sessionId      String                  @unique
  session        ConsultationSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  mainProblem    String
  education      String
  warning        String
  followUpAdvice String
  finalStatus    ConsultationFinalStatus
  createdBy      String
  creator        User                    @relation("SummaryCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt      DateTime                @default(now())

  @@index([createdBy])
}

model DrugInformation {
  id                String                @id @default(cuid())
  slug              String                @unique
  genericName       String
  brandNames        String[]              @default([])
  aliases           String[]              @default([])
  drugClass         String?
  dosageForm        String?
  uses              String
  generalUsage      String
  foodGuidance      String?
  commonSideEffects String
  warnings          String
  seekHelpWhen      String
  pharmacistIndications String?
  counselingPoints      String[]          @default([])
  screeningQuestions    String[]          @default([])
  contraindications     String[]          @default([])
  majorInteractions     String[]          @default([])
  seriousSideEffects    String[]          @default([])
  monitoringParameters  String[]          @default([])
  referralCriteria      String[]          @default([])
  internalNotes         String?
  references            String[]          @default([])
  definition                              String?
  pharmacology                            String?
  formulation                             String?
  indicationsAndDosage                    String?
  sideEffectsAndInteractions              String?
  pregnancyUse                            String?
  contraindicationsAndWarnings            String?
  clinicalMonitoring                      String?
  counselingPointsMarkdown                String?
  referencesMarkdown                      String?
  reviewDueAt           DateTime?
  reviewerId        String
  reviewer          User                  @relation("DrugReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewedAt        DateTime
  status            DrugPublicationStatus @default(DRAFT)
  adminNote         String?
  revisesDrugId     String?
  revisesDrug       DrugInformation?      @relation("DrugRevision", fields: [revisesDrugId], references: [id], onDelete: SetNull)
  revisionDrafts    DrugInformation[]     @relation("DrugRevision")
  isDemo            Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([status])
  @@index([genericName])
  @@index([revisesDrugId])
}

model Article {
  id              String                   @id @default(cuid())
  title           String
  slug            String                   @unique
  category        String
  excerpt         String
  contentMarkdown String
  metaTitle       String?
  metaDescription String?
  coverImageUrl   String?
  status          ArticlePublicationStatus @default(DRAFT)
  adminNote       String?
  authorId        String
  author          User                     @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewedAt      DateTime?
  publishedAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([status])
  @@index([category])
  @@index([authorId])
  @@index([publishedAt])
}

model EducationalVideo {
  id               String                             @id @default(cuid())
  title            String
  slug             String                             @unique
  category         String
  excerpt          String
  youtubeUrl       String
  youtubeVideoId   String
  metaTitle        String?
  metaDescription  String?
  status           EducationalVideoPublicationStatus  @default(DRAFT)
  adminNote        String?
  authorId         String
  author           User                               @relation("EducationalVideoAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewedAt       DateTime?
  publishedAt      DateTime?
  createdAt        DateTime                           @default(now())
  updatedAt        DateTime                           @updatedAt

  @@index([status])
  @@index([category])
  @@index([authorId])
  @@index([publishedAt])
}

model ContentCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([name])
}

model ForumCategory {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  threads     ForumThread[]

  @@index([isActive])
  @@index([name])
}

model ForumThread {
  id            String              @id @default(cuid())
  title         String
  slug          String              @unique
  categoryId    String
  category      ForumCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  authorId      String
  author        User                @relation("ForumThreadAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  status        ForumThreadStatus   @default(ACTIVE)
  isPinned      Boolean             @default(false)
  lockedAt      DateTime?
  lockedById    String?
  lockedBy      User?               @relation("ForumThreadLocker", fields: [lockedById], references: [id], onDelete: SetNull)
  hiddenAt      DateTime?
  hiddenById    String?
  hiddenBy      User?               @relation("ForumThreadHider", fields: [hiddenById], references: [id], onDelete: SetNull)
  hiddenReason  String?
  lastPostAt    DateTime            @default(now())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  posts         ForumPost[]
  reports       ForumReport[]
  subscriptions ForumSubscription[]

  @@index([categoryId])
  @@index([authorId])
  @@index([status])
  @@index([isPinned, lastPostAt])
  @@index([lastPostAt])
  @@index([lockedById])
  @@index([hiddenById])
}

model ForumPost {
  id           String            @id @default(cuid())
  threadId     String
  thread       ForumThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  parentPostId String?
  parentPost   ForumPost?        @relation("ForumPostReplies", fields: [parentPostId], references: [id], onDelete: Cascade)
  replies      ForumPost[]       @relation("ForumPostReplies")
  authorId     String
  author       User              @relation("ForumPostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  bodyMarkdown String
  status       ForumPostStatus   @default(VISIBLE)
  hiddenAt     DateTime?
  hiddenById   String?
  hiddenBy     User?             @relation("ForumPostHider", fields: [hiddenById], references: [id], onDelete: SetNull)
  hiddenReason String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  reports      ForumReport[]
  attachments  ForumPostAttachment[]

  @@index([threadId])
  @@index([parentPostId])
  @@index([authorId])
  @@index([status])
  @@index([createdAt])
  @@index([hiddenById])
}

model ForumPostAttachment {
  id        String    @id @default(cuid())
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy User      @relation("ForumPostAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  fileUrl   String
  fileName  String
  altText   String?
  isInline  Boolean   @default(false)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([postId])
  @@index([uploadedById])
  @@index([isInline])
}

model ForumReport {
  id             String                @id @default(cuid())
  targetType     ForumReportTargetType
  threadId       String?
  thread         ForumThread?          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  postId         String?
  post           ForumPost?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId     String
  reporter       User                  @relation("ForumReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason         String
  status         ForumReportStatus     @default(OPEN)
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?                 @relation("ForumReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([targetType])
  @@index([threadId])
  @@index([postId])
  @@index([reporterId])
  @@index([status])
  @@index([resolvedById])
}

model ForumSubscription {
  id         String      @id @default(cuid())
  threadId   String
  thread     ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime    @default(now())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([threadId, userId])
  @@index([userId])
  @@index([threadId])
}
